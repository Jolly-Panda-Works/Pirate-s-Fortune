{
  "name": "pirates-fortune",
  "version": "2.1.0",
  "description": "Pirate's Fortune — 3D multiplayer push-your-luck pirate card game (React Three Fiber + Colyseus + Capacitor).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=js --watch-path=shared server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/**/*.test.js server/*.test.js",
    "test:engine": "node --test --test-reporter=tap tests/**/*.test.js",
    "assets:synty": "node tools/assets/build-synty.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "three.quarks": "^0.17.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@gltf-transform/cli": "^4.5.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "vite": "^7.3.7"
  }
}
